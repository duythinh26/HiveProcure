C4Container
  title Container view - Option C: event-driven matching over precomputed projections
  Person(ap, "AP Analyst", "Reviews emitted match results")
  System_Ext(erp, "ERP / Procurement system", "Emits purchase order, goods receipt and invoice events")
  System_Boundary(mp, "Invoice Matching Platform") {
    Container(bus, "Event Backbone", "Kafka", "Topics for po.line, receipt.posted, invoice.received and match.result")
    Container(adapter, "ERP Event Adapter", "Stream producer", "Normalises ERP records into domain events with event time")
    Container(recproj, "Receipt Projection Worker", "Stream processor", "Keeps running sum of receipts per PO item, defaulting to 0 when none exist")
    ContainerDb(recstore, "Received Quantity Store", "RocksDB / state store", "Current received quantity keyed by PO and item text")
    Container(dupproj, "Duplicate Index Worker", "Stream processor", "Maintains a rolling 30-day index of supplier, PO and invoice total fingerprints keyed by received time")
    ContainerDb(dupstore, "Duplicate Fingerprint Index", "RocksDB / state store", "Fingerprints with expiry so entries older than 30 days drop out")
    Container(matcher, "Stateless Rule Matcher", "Stream processor", "Joins invoice line, PO line, received quantity, duplicate hit and category tolerances; applies the six rules in order and emits one result")
    ContainerDb(refstore, "Category Tolerance Reference", "Compacted topic / KTable", "Price and quantity tolerance per category, e.g. IT Hardware and Office Supplies")
    Container(readapi, "Result Query API", "HTTP service", "Serves decided results and the fact snapshot behind each one")
    ContainerDb(readdb, "Result Read Model", "PostgreSQL", "Materialised match results with inputs for audit")
    Container(ui, "Exception Review UI", "Web app", "Lists exceptions by result type")
  }
  Rel(erp, adapter, "Publishes source records", "API / CDC")
  Rel(adapter, bus, "Produces domain events", "Kafka protocol")
  Rel(bus, recproj, "Streams receipt.posted", "Kafka protocol")
  Rel(recproj, recstore, "Updates running sums")
  Rel(bus, dupproj, "Streams invoice.received", "Kafka protocol")
  Rel(dupproj, dupstore, "Writes and expires fingerprints")
  Rel(bus, matcher, "Streams invoice.received and po.line", "Kafka protocol")
  Rel(matcher, recstore, "Looks up received quantity")
  Rel(matcher, dupstore, "Checks for an earlier matching fingerprint inside the window")
  Rel(matcher, refstore, "Reads tolerances for the PO category")
  Rel(matcher, bus, "Emits match.result", "Kafka protocol")
  Rel(bus, readapi, "Streams match.result", "Kafka protocol")
  Rel(readapi, readdb, "Materialises results", "SQL")
  Rel(ui, readapi, "Queries results", "JSON over HTTPS")
  Rel(ap, ui, "Reviews exceptions", "HTTPS")
  UpdateLayoutConfig($c4ShapeInRow="3", $c4BoundaryInRow="1")